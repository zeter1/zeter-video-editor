{
  "$schema": "./runtime-manifest.schema.json",
  "manifest_version": 1,
  "app": {
    "version": "0.0.1",
    "build": "unreleased",
    "project_schema_min": 1,
    "project_schema_max": 2
  },
  "ffmpeg": {
    "file": "ffmpeg.exe",
    "version_contains": "ffmpeg version 8.0.1-full_build-www.gyan.dev",
    "build_identity": "8.0.1-full_build-www.gyan.dev",
    "license": "Release workflow must pin and document the redistributed FFmpeg build/license/source before production publication."
  },
  "ffprobe": {
    "file": "ffprobe.exe",
    "version_contains": "ffprobe version 8.0.1-full_build-www.gyan.dev",
    "build_identity": "8.0.1-full_build-www.gyan.dev"
  },
  "whisper_cli": {
    "file": "whisper-cli.exe",
    "version_contains": "whisper.cpp version: 1.9.4",
    "build_identity": "whisper.cpp-1.9.4",
    "license": "MIT; source pinned to https://github.com/ggml-org/whisper.cpp/tree/v1.9.4"
  },
  "ai_worker": {
    "file": "zeter-ai-worker.exe",
    "protocol_version": 1,
    "build_identity": "0.0.1"
  },
  "models": {
    "backend": "whisper.cpp",
    "compatibility": ">=1.7,<2.0"
  }
}
